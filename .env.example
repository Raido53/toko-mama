# Aplikasi
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000

# Database: pilih salah satu.
# Supabase (PostgreSQL) — cukup isi DATABASE_URL, client otomatis 'postgres'.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# DB_CLIENT=postgres

# MySQL (lokal)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=toko_mama

# TLS untuk MySQL hosted (Supabase sudah TLS lewat sslmode=require).
# DB_SSL=true
# DB_SSL_VERIFY=true
# DB_CONNECTION_LIMIT=5

# Wajib diisi di production (acak, minimal 32 karakter)
SESSION_SECRET=ubah-secret-ini-di-production
